// Esquema Prisma.
//
// Fase 1 (base técnica y offline/sync): Species, Pond, SyncOperation.
// Fase 2 (producción piscícola): FishBatch, Stocking, FishTransfer, y
// campos nuevos en Species/Pond. Fase 3 (operación diaria): Feed,
// FeedInventoryMovement, FeedingRecord, MortalityRecord, Sampling. El
// resto del modelo de datos completo del dominio piscícola está
// documentado en IMPLEMENTATION_PLAN.md §4 y se implementará de forma
// incremental en las siguientes fases.

// Prisma 7 requiere el generador "prisma-client" (ESM/CJS configurable) con
// una ruta de salida explícita, y ya no acepta la URL de conexión dentro de
// este archivo: eso ahora vive en "prisma.config.ts" (ver IMPLEMENTATION_PLAN.md
// §3.3, fila `prisma`). Se usa `moduleFormat = "cjs"` para no forzar todo el
// proyecto Next.js a ESM puro.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PondStatus {
  EMPTY
  PREPARATION
  ACTIVE
  HARVEST
  CLEANING
  MAINTENANCE
}

/// Modo de un campo geométrico del estanque (IMPLEMENTATION_PLAN.md §4 /
/// src/lib/domain/pondGeometry.ts): "CALCULATED" se deriva automáticamente
/// de las medidas; "MANUAL" lo fijó la persona y ya no se recalcula solo.
enum GeometrySource {
  CALCULATED
  MANUAL
}

enum BatchStatus {
  PLANNED
  STOCKED
  GROWING
  PRE_HARVEST
  PARTIAL_HARVEST
  HARVESTED
  CLOSED
}

/// Tipo de movimiento de inventario de alimento (§4-§5 del encargo de
/// Fase 3). El signo NUNCA se guarda: se deriva del tipo en
/// src/lib/domain/feedLedger.ts (getFeedMovementSignedQuantity), la única
/// fuente de esa regla.
enum FeedMovementType {
  PURCHASE
  INITIAL_STOCK
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  RETURN
}

/// Turno de alimentación (§8). La UI muestra "Mañana/Mediodía/Tarde/Noche".
enum FeedingShift {
  MORNING
  MIDDAY
  AFTERNOON
  NIGHT
}

/// Causa de mortalidad (§15). La UI muestra los textos en español.
enum MortalityCause {
  UNKNOWN
  LOW_OXYGEN
  DISEASE
  HANDLING
  PREDATORS
  TEMPERATURE
  WATER_QUALITY
  ACCIDENT
  OTHER
}

enum SyncOperationType {
  CREATE
  UPDATE
  DELETE
}

enum SyncOperationStatus {
  applied
  duplicate
  conflict
  error
}

/// Catálogo configurable de especies (§11 del plan). No se codifican
/// especies fijas: el usuario puede crear, modificar y desactivar.
model Species {
  id                       String   @id @default(uuid())
  commonName               String
  scientificName           String?
  description              String?
  targetWeightKg           Decimal? @db.Decimal(10, 3)
  estimatedCycleDays       Int?
  minTemperatureC          Decimal? @db.Decimal(4, 1)
  maxTemperatureC          Decimal? @db.Decimal(4, 1)
  minPh                    Decimal? @db.Decimal(4, 2)
  maxPh                    Decimal? @db.Decimal(4, 2)
  minDissolvedOxygenMgL    Decimal? @db.Decimal(5, 2)
  expectedFcr              Decimal? @db.Decimal(5, 2)
  expectedMortalityPercent Decimal? @db.Decimal(5, 2)
  active                   Boolean  @default(true)

  // Campos de auditoría/sincronización — presentes en toda entidad
  // sincronizable (IMPLEMENTATION_PLAN.md §4.1).
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  fishBatches FishBatch[]

  @@index([active])
  @@map("species")
}

/// Estanques (§12 del plan; §3-§4 de la Fase 2). El área y el volumen
/// pueden derivarse de las medidas o fijarse a mano — ver GeometrySource
/// y src/lib/domain/pondGeometry.ts para la lógica exacta.
model Pond {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  type              String?
  lengthM           Decimal?       @db.Decimal(8, 2)
  widthM            Decimal?       @db.Decimal(8, 2)
  averageDepthM     Decimal?       @db.Decimal(8, 2)
  areaM2            Decimal?       @db.Decimal(10, 2)
  areaSource        GeometrySource @default(CALCULATED)
  estimatedVolumeM3 Decimal?       @db.Decimal(10, 2)
  volumeSource      GeometrySource @default(CALCULATED)
  capacityNotes     String?
  locationNotes     String?
  notes             String?
  status            PondStatus     @default(EMPTY)
  active            Boolean        @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  stockings        Stocking[]
  transfersFrom    FishTransfer[]    @relation("TransferFromPond")
  transfersTo      FishTransfer[]    @relation("TransferToPond")
  feedingRecords   FeedingRecord[]
  mortalityRecords MortalityRecord[]
  samplings        Sampling[]

  @@index([status])
  @@index([active])
  @@map("ponds")
}

/// Lote productivo (§5 del encargo de Fase 2): un grupo de peces de una
/// misma especie y siembra inicial. NO tiene un "currentPondId": dónde
/// está el lote se deriva siempre de Stocking + FishTransfer (§9, §11,
/// §13 — ver src/lib/domain/batchLedger.ts), porque un lote puede estar
/// repartido entre varios estanques a la vez.
model FishBatch {
  id                    String      @id @default(uuid())
  code                  String      @unique
  speciesId             String
  species               Species     @relation(fields: [speciesId], references: [id])
  supplierId            String?
  purchaseDate          DateTime?
  initialStockingDate   DateTime
  initialQuantity       Int
  initialAverageWeightG Decimal     @db.Decimal(10, 2)
  initialBiomassKg      Decimal     @db.Decimal(12, 3)
  fryCost               Decimal?    @db.Decimal(12, 2)
  targetWeightKg        Decimal?    @db.Decimal(10, 3)
  expectedHarvestDate   DateTime?
  status                BatchStatus @default(PLANNED)
  notes                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  stockings        Stocking[]
  transfers        FishTransfer[]
  feedingRecords   FeedingRecord[]
  mortalityRecords MortalityRecord[]
  samplings        Sampling[]

  @@index([speciesId])
  @@index([status])
  @@map("fish_batches")
}

/// Siembra (§8): evento append-only. Deja evidencia histórica de dónde y
/// cuándo entró cada lote — nunca se representa solo como
/// "FishBatch.pondId = E01", eso perdería trazabilidad (§9 del encargo).
model Stocking {
  id              String    @id @default(uuid())
  batchId         String
  batch           FishBatch @relation(fields: [batchId], references: [id])
  pondId          String
  pond            Pond      @relation(fields: [pondId], references: [id])
  date            DateTime
  quantity        Int
  averageWeightG  Decimal   @db.Decimal(10, 2)
  biomassKg       Decimal   @db.Decimal(12, 3)
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@map("stockings")
}

/// Traslado (§10-§11): evento append-only. Soporta traslados parciales —
/// un mismo lote puede quedar repartido entre origen y destino.
model FishTransfer {
  id              String    @id @default(uuid())
  batchId         String
  batch           FishBatch @relation(fields: [batchId], references: [id])
  fromPondId      String
  fromPond        Pond      @relation("TransferFromPond", fields: [fromPondId], references: [id])
  toPondId        String
  toPond          Pond      @relation("TransferToPond", fields: [toPondId], references: [id])
  date            DateTime
  quantity        Int
  averageWeightG  Decimal?  @db.Decimal(10, 2)
  biomassKg       Decimal?  @db.Decimal(12, 3)
  reason          String?
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([fromPondId])
  @@index([toPondId])
  @@map("fish_transfers")
}

/// Catálogo configurable de alimentos (§3 del encargo de Fase 3). No se
/// codifican alimentos fijos, igual criterio que Species.
model Feed {
  id               String   @id @default(uuid())
  name             String
  brand            String?
  proteinPercent   Decimal? @db.Decimal(5, 2)
  pelletSizeMm     Decimal? @db.Decimal(6, 2)
  bagWeightKg      Decimal? @db.Decimal(8, 2)
  defaultBagPrice  Decimal? @db.Decimal(12, 2)
  defaultCostPerKg Decimal? @db.Decimal(12, 4)
  recommendedStage String?
  notes            String?
  minimumStockKg   Decimal? @db.Decimal(10, 2)
  active           Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  inventoryMovements FeedInventoryMovement[]
  feedingRecords     FeedingRecord[]

  @@index([active])
  @@map("feeds")
}

/// Ledger de inventario de alimento (§4-§7): evento append-only. El stock
/// de un alimento NUNCA es un campo mutable — se deriva siempre de estos
/// movimientos (src/lib/domain/feedLedger.ts). `quantityKg` siempre se
/// guarda positivo; el signo lo decide `movementType`.
model FeedInventoryMovement {
  id            String           @id @default(uuid())
  feedId        String
  feed          Feed             @relation(fields: [feedId], references: [id])
  movementType  FeedMovementType
  quantityKg    Decimal          @db.Decimal(10, 3)
  unitCostPerKg Decimal?         @db.Decimal(12, 4)
  totalCost     Decimal?         @db.Decimal(12, 2)
  date          DateTime
  /// Origen del movimiento cuando no es manual — p. ej. "FEEDING" cuando
  /// lo generó un FeedingRecord (§9). `sourceType`+`sourceId` identifican
  /// unívocamente ese origen: la restricción única de abajo es la que
  /// garantiza que un mismo FeedingRecord nunca descuente alimento dos
  /// veces, incluso si el push que lo generó se reintenta.
  sourceType    String?
  sourceId      String?
  notes         String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([sourceType, sourceId])
  @@index([feedId])
  @@index([feedId, date])
  @@index([movementType])
  @@map("feed_inventory_movements")
}

/// Registro diario de alimentación (§8-§9): evento append-only. Cada
/// registro genera exactamente un FeedInventoryMovement CONSUMPTION
/// vinculado (sourceType="FEEDING", sourceId=este id).
model FeedingRecord {
  id              String        @id @default(uuid())
  batchId         String
  batch           FishBatch     @relation(fields: [batchId], references: [id])
  pondId          String
  pond            Pond          @relation(fields: [pondId], references: [id])
  feedId          String
  feed            Feed          @relation(fields: [feedId], references: [id])
  date            DateTime
  time            String?
  quantityKg      Decimal       @db.Decimal(10, 3)
  shift           FeedingShift?
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([feedId])
  @@index([date])
  @@map("feeding_records")
}

/// Mortalidad (§15-§19): evento append-only, integrado en el ledger de
/// peces como una salida más (src/lib/domain/batchLedger.ts).
model MortalityRecord {
  id                      String         @id @default(uuid())
  batchId                 String
  batch                   FishBatch      @relation(fields: [batchId], references: [id])
  pondId                  String
  pond                    Pond           @relation(fields: [pondId], references: [id])
  date                    DateTime
  quantity                Int
  estimatedAverageWeightG Decimal?       @db.Decimal(10, 2)
  cause                   MortalityCause @default(UNKNOWN)
  notes                   String?
  responsibleName         String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@index([date])
  @@map("mortality_records")
}

/// Muestreo (§21-§24): evento append-only. `averageWeightG` se calcula a
/// partir de `sampleFishCount`/`totalSampleWeightKg` antes de guardar
/// (nunca se le pide a la persona que lo calcule) y queda almacenado
/// junto a sus propios insumos — no es un valor mutable global, es el
/// resultado intrínseco de este muestreo puntual.
model Sampling {
  id                  String    @id @default(uuid())
  batchId             String
  batch               FishBatch @relation(fields: [batchId], references: [id])
  pondId              String
  pond                Pond      @relation(fields: [pondId], references: [id])
  date                DateTime
  sampleFishCount     Int
  totalSampleWeightKg Decimal   @db.Decimal(10, 3)
  averageWeightG      Decimal   @db.Decimal(10, 2)
  averageLengthCm     Decimal?  @db.Decimal(6, 2)
  notes               String?
  responsibleName     String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@index([date])
  @@map("samplings")
}

/// Registro de operaciones de sincronización procesadas por el servidor.
/// `operationId` es la clave de idempotencia (§6.5 del plan): reenviar la
/// misma operación de la cola local (mismo id) nunca vuelve a aplicar su
/// efecto sobre las tablas de negocio.
model SyncOperation {
  id           String              @id @default(uuid())
  operationId  String              @unique
  entityType   String
  entityId     String
  operation    SyncOperationType
  deviceId     String
  status       SyncOperationStatus
  errorMessage String?
  processedAt  DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([processedAt])
  @@map("sync_operations")
}
