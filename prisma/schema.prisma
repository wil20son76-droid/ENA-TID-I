// Esquema Prisma.
//
// Fase 1 (base técnica y offline/sync): Species, Pond, SyncOperation.
// Fase 2 (producción piscícola): FishBatch, Stocking, FishTransfer, y
// campos nuevos en Species/Pond. Fase 3 (operación diaria): Feed,
// FeedInventoryMovement, FeedingRecord, MortalityRecord, Sampling.
// Fase 4 (calidad del agua, alertas y planificación): WaterQualityRecord,
// Task. Fase 5 (economía y cierre productivo): FarmSettings, Supplier,
// Customer, Purchase/PurchaseLine, Expense, Harvest, Sale/SaleLine. Ver
// ECONOMICS.md para la política contable (Purchase vs Expense, costo de
// inventario de alimento, cómo se evita el doble conteo).

// Prisma 7 requiere el generador "prisma-client" (ESM/CJS configurable) con
// una ruta de salida explícita, y ya no acepta la URL de conexión dentro de
// este archivo: eso ahora vive en "prisma.config.ts" (ver IMPLEMENTATION_PLAN.md
// §3.3, fila `prisma`). Se usa `moduleFormat = "cjs"` para no forzar todo el
// proyecto Next.js a ESM puro.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PondStatus {
  EMPTY
  PREPARATION
  ACTIVE
  HARVEST
  CLEANING
  MAINTENANCE
}

/// Modo de un campo geométrico del estanque (IMPLEMENTATION_PLAN.md §4 /
/// src/lib/domain/pondGeometry.ts): "CALCULATED" se deriva automáticamente
/// de las medidas; "MANUAL" lo fijó la persona y ya no se recalcula solo.
enum GeometrySource {
  CALCULATED
  MANUAL
}

enum BatchStatus {
  PLANNED
  STOCKED
  GROWING
  PRE_HARVEST
  PARTIAL_HARVEST
  HARVESTED
  CLOSED
}

/// Tipo de movimiento de inventario de alimento (§4-§5 del encargo de
/// Fase 3). El signo NUNCA se guarda: se deriva del tipo en
/// src/lib/domain/feedLedger.ts (getFeedMovementSignedQuantity), la única
/// fuente de esa regla.
enum FeedMovementType {
  PURCHASE
  INITIAL_STOCK
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  RETURN
}

/// Turno de alimentación (§8). La UI muestra "Mañana/Mediodía/Tarde/Noche".
enum FeedingShift {
  MORNING
  MIDDAY
  AFTERNOON
  NIGHT
}

/// Causa de mortalidad (§15). La UI muestra los textos en español.
enum MortalityCause {
  UNKNOWN
  LOW_OXYGEN
  DISEASE
  HANDLING
  PREDATORS
  TEMPERATURE
  WATER_QUALITY
  ACCIDENT
  OTHER
}

/// Estado de una tarea (§18-§22 del encargo de Fase 4). A diferencia del
/// resto del dominio productivo de esta app, Task SÍ es mutable (§19):
/// se edita y se completa desde cualquier dispositivo, con el mismo
/// versionado/conflicto last-write-wins que Species/Pond/Feed.
enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Tipo de línea de compra (§8-§9 del encargo de Fase 5). "FEED" es el
/// único que puede generar un FeedInventoryMovement PURCHASE vinculado.
enum PurchaseItemType {
  FEED
  FRY
  MEDICINE
  MATERIAL
  EQUIPMENT
  OTHER
}

/// Categoría de gasto (§17 del encargo). Nunca incluye "compra de
/// alimento": esa siempre pasa por Purchase (§1 — ver ECONOMICS.md).
enum ExpenseCategory {
  FRY
  FUEL
  ELECTRICITY
  LABOR
  TRANSPORT
  MAINTENANCE
  CONSTRUCTION
  TOOLS
  EQUIPMENT
  MEDICINE
  SERVICES
  OTHER
}

/// Tipo de cliente/comprador (§6-§7).
enum CustomerType {
  INDIVIDUAL
  RESTAURANT
  MARKET
  DISTRIBUTOR
  WHOLESALER
  OTHER
}

/// Tipo de cosecha (§20): total cierra la producción del lote, parcial no.
enum HarvestType {
  PARTIAL
  TOTAL
}

/// Estado de pago de una compra o venta (§32 del encargo). Deliberadamente
/// simple — no es un módulo de cuentas por cobrar/pagar completo (§59, §76).
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

/// Rol de acceso (Fase 7, §"Roles básicos"). Se mapea a etiquetas en
/// español vía src/lib/labels.ts, mismo criterio que el resto de los
/// enums de este esquema. La jerarquía NO es lineal: "READ_ONLY" no es
/// "menos" que "WORKER", es un eje ortogonal (solo lectura, cero
/// escritura) — ver src/lib/auth/permissions.ts para el modelo de
/// capacidades real, que es lo único que decide autorización.
enum UserRole {
  ADMIN
  MANAGER
  WORKER
  READ_ONLY
}

enum SyncOperationType {
  CREATE
  UPDATE
  DELETE
}

enum SyncOperationStatus {
  applied
  duplicate
  conflict
  error
}

/// Catálogo configurable de especies (§11 del plan). No se codifican
/// especies fijas: el usuario puede crear, modificar y desactivar.
model Species {
  id                       String   @id @default(uuid())
  commonName               String
  scientificName           String?
  description              String?
  targetWeightKg           Decimal? @db.Decimal(10, 3)
  estimatedCycleDays       Int?
  minTemperatureC          Decimal? @db.Decimal(4, 1)
  maxTemperatureC          Decimal? @db.Decimal(4, 1)
  minPh                    Decimal? @db.Decimal(4, 2)
  maxPh                    Decimal? @db.Decimal(4, 2)
  minDissolvedOxygenMgL    Decimal? @db.Decimal(5, 2)
  expectedFcr              Decimal? @db.Decimal(5, 2)
  expectedMortalityPercent Decimal? @db.Decimal(5, 2)
  active                   Boolean  @default(true)

  // Campos de auditoría/sincronización — presentes en toda entidad
  // sincronizable (IMPLEMENTATION_PLAN.md §4.1).
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  fishBatches FishBatch[]

  @@index([active])
  @@index([updatedAt])
  @@map("species")
}

/// Estanques (§12 del plan; §3-§4 de la Fase 2). El área y el volumen
/// pueden derivarse de las medidas o fijarse a mano — ver GeometrySource
/// y src/lib/domain/pondGeometry.ts para la lógica exacta.
model Pond {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  type              String?
  lengthM           Decimal?       @db.Decimal(8, 2)
  widthM            Decimal?       @db.Decimal(8, 2)
  averageDepthM     Decimal?       @db.Decimal(8, 2)
  areaM2            Decimal?       @db.Decimal(10, 2)
  areaSource        GeometrySource @default(CALCULATED)
  estimatedVolumeM3 Decimal?       @db.Decimal(10, 2)
  volumeSource      GeometrySource @default(CALCULATED)
  capacityNotes     String?
  locationNotes     String?
  notes             String?
  status            PondStatus     @default(EMPTY)
  active            Boolean        @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  stockings           Stocking[]
  transfersFrom       FishTransfer[]       @relation("TransferFromPond")
  transfersTo         FishTransfer[]       @relation("TransferToPond")
  feedingRecords      FeedingRecord[]
  mortalityRecords    MortalityRecord[]
  samplings           Sampling[]
  waterQualityRecords WaterQualityRecord[]
  tasks               Task[]
  expenses            Expense[]
  harvests            Harvest[]

  @@index([status])
  @@index([active])
  @@index([updatedAt])
  @@map("ponds")
}

/// Lote productivo (§5 del encargo de Fase 2): un grupo de peces de una
/// misma especie y siembra inicial. NO tiene un "currentPondId": dónde
/// está el lote se deriva siempre de Stocking + FishTransfer (§9, §11,
/// §13 — ver src/lib/domain/batchLedger.ts), porque un lote puede estar
/// repartido entre varios estanques a la vez.
model FishBatch {
  id                    String      @id @default(uuid())
  code                  String      @unique
  speciesId             String
  species               Species     @relation(fields: [speciesId], references: [id])
  supplierId            String?
  purchaseDate          DateTime?
  initialStockingDate   DateTime
  initialQuantity       Int
  initialAverageWeightG Decimal     @db.Decimal(10, 2)
  initialBiomassKg      Decimal     @db.Decimal(12, 3)
  fryCost               Decimal?    @db.Decimal(12, 2)
  targetWeightKg        Decimal?    @db.Decimal(10, 3)
  expectedHarvestDate   DateTime?
  status                BatchStatus @default(PLANNED)
  notes                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  stockings           Stocking[]
  transfers           FishTransfer[]
  feedingRecords      FeedingRecord[]
  mortalityRecords    MortalityRecord[]
  samplings           Sampling[]
  waterQualityRecords WaterQualityRecord[]
  tasks               Task[]
  expenses            Expense[]
  harvests            Harvest[]
  saleLines           SaleLine[]

  @@index([speciesId])
  @@index([status])
  @@index([updatedAt])
  @@map("fish_batches")
}

/// Siembra (§8): evento append-only. Deja evidencia histórica de dónde y
/// cuándo entró cada lote — nunca se representa solo como
/// "FishBatch.pondId = E01", eso perdería trazabilidad (§9 del encargo).
model Stocking {
  id              String    @id @default(uuid())
  batchId         String
  batch           FishBatch @relation(fields: [batchId], references: [id])
  pondId          String
  pond            Pond      @relation(fields: [pondId], references: [id])
  date            DateTime
  quantity        Int
  averageWeightG  Decimal   @db.Decimal(10, 2)
  biomassKg       Decimal   @db.Decimal(12, 3)
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@index([updatedAt])
  @@map("stockings")
}

/// Traslado (§10-§11): evento append-only. Soporta traslados parciales —
/// un mismo lote puede quedar repartido entre origen y destino.
model FishTransfer {
  id              String    @id @default(uuid())
  batchId         String
  batch           FishBatch @relation(fields: [batchId], references: [id])
  fromPondId      String
  fromPond        Pond      @relation("TransferFromPond", fields: [fromPondId], references: [id])
  toPondId        String
  toPond          Pond      @relation("TransferToPond", fields: [toPondId], references: [id])
  date            DateTime
  quantity        Int
  averageWeightG  Decimal?  @db.Decimal(10, 2)
  biomassKg       Decimal?  @db.Decimal(12, 3)
  reason          String?
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([fromPondId])
  @@index([toPondId])
  @@index([createdAt])
  @@map("fish_transfers")
}

/// Catálogo configurable de alimentos (§3 del encargo de Fase 3). No se
/// codifican alimentos fijos, igual criterio que Species.
model Feed {
  id               String   @id @default(uuid())
  name             String
  brand            String?
  proteinPercent   Decimal? @db.Decimal(5, 2)
  pelletSizeMm     Decimal? @db.Decimal(6, 2)
  bagWeightKg      Decimal? @db.Decimal(8, 2)
  defaultBagPrice  Decimal? @db.Decimal(12, 2)
  defaultCostPerKg Decimal? @db.Decimal(12, 4)
  recommendedStage String?
  notes            String?
  minimumStockKg   Decimal? @db.Decimal(10, 2)
  active           Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  inventoryMovements FeedInventoryMovement[]
  feedingRecords     FeedingRecord[]
  purchaseLines      PurchaseLine[]

  @@index([active])
  @@index([updatedAt])
  @@map("feeds")
}

/// Ledger de inventario de alimento (§4-§7): evento append-only. El stock
/// de un alimento NUNCA es un campo mutable — se deriva siempre de estos
/// movimientos (src/lib/domain/feedLedger.ts). `quantityKg` siempre se
/// guarda positivo; el signo lo decide `movementType`.
model FeedInventoryMovement {
  id            String           @id @default(uuid())
  feedId        String
  feed          Feed             @relation(fields: [feedId], references: [id])
  movementType  FeedMovementType
  quantityKg    Decimal          @db.Decimal(10, 3)
  unitCostPerKg Decimal?         @db.Decimal(12, 4)
  totalCost     Decimal?         @db.Decimal(12, 2)
  date          DateTime
  /// Origen del movimiento cuando no es manual — p. ej. "FEEDING" cuando
  /// lo generó un FeedingRecord (§9). `sourceType`+`sourceId` identifican
  /// unívocamente ese origen: la restricción única de abajo es la que
  /// garantiza que un mismo FeedingRecord nunca descuente alimento dos
  /// veces, incluso si el push que lo generó se reintenta.
  sourceType    String?
  sourceId      String?
  notes         String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([sourceType, sourceId])
  @@index([feedId])
  @@index([feedId, date])
  @@index([movementType])
  @@index([createdAt])
  @@map("feed_inventory_movements")
}

/// Registro diario de alimentación (§8-§9): evento append-only. Cada
/// registro genera exactamente un FeedInventoryMovement CONSUMPTION
/// vinculado (sourceType="FEEDING", sourceId=este id).
model FeedingRecord {
  id              String        @id @default(uuid())
  batchId         String
  batch           FishBatch     @relation(fields: [batchId], references: [id])
  pondId          String
  pond            Pond          @relation(fields: [pondId], references: [id])
  feedId          String
  feed            Feed          @relation(fields: [feedId], references: [id])
  date            DateTime
  time            String?
  quantityKg      Decimal       @db.Decimal(10, 3)
  shift           FeedingShift?
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([feedId])
  @@index([date])
  @@index([createdAt])
  @@map("feeding_records")
}

/// Mortalidad (§15-§19): evento append-only, integrado en el ledger de
/// peces como una salida más (src/lib/domain/batchLedger.ts).
model MortalityRecord {
  id                      String         @id @default(uuid())
  batchId                 String
  batch                   FishBatch      @relation(fields: [batchId], references: [id])
  pondId                  String
  pond                    Pond           @relation(fields: [pondId], references: [id])
  date                    DateTime
  quantity                Int
  estimatedAverageWeightG Decimal?       @db.Decimal(10, 2)
  cause                   MortalityCause @default(UNKNOWN)
  notes                   String?
  responsibleName         String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@index([date])
  @@index([createdAt])
  @@map("mortality_records")
}

/// Muestreo (§21-§24): evento append-only. `averageWeightG` se calcula a
/// partir de `sampleFishCount`/`totalSampleWeightKg` antes de guardar
/// (nunca se le pide a la persona que lo calcule) y queda almacenado
/// junto a sus propios insumos — no es un valor mutable global, es el
/// resultado intrínseco de este muestreo puntual.
model Sampling {
  id                  String    @id @default(uuid())
  batchId             String
  batch               FishBatch @relation(fields: [batchId], references: [id])
  pondId              String
  pond                Pond      @relation(fields: [pondId], references: [id])
  date                DateTime
  sampleFishCount     Int
  totalSampleWeightKg Decimal   @db.Decimal(10, 3)
  averageWeightG      Decimal   @db.Decimal(10, 2)
  averageLengthCm     Decimal?  @db.Decimal(6, 2)
  notes               String?
  responsibleName     String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@index([date])
  @@index([createdAt])
  @@map("samplings")
}

/// Medición de calidad del agua (§1-§11 del encargo de Fase 4): evento
/// append-only, mismo principio de ledger que el resto del dominio — NO
/// existe `pond.currentPh`/`pond.currentTemperature`: la última medición,
/// la tendencia y la alerta actual se derivan siempre de este historial
/// (src/lib/domain/waterQuality.ts). Solo `pondId` es obligatorio además
/// de la fecha; todo parámetro medido es opcional (§2) — el requisito
/// mínimo (estanque + fecha + al menos un parámetro) se valida en la capa
/// de aplicación, no en el esquema.
model WaterQualityRecord {
  id                 String     @id @default(uuid())
  pondId             String
  pond               Pond       @relation(fields: [pondId], references: [id])
  batchId            String?
  batch              FishBatch? @relation(fields: [batchId], references: [id])
  date               DateTime
  time               String?
  temperatureC       Decimal?   @db.Decimal(4, 1)
  ph                 Decimal?   @db.Decimal(4, 2)
  dissolvedOxygenMgL Decimal?   @db.Decimal(5, 2)
  transparencyCm     Decimal?   @db.Decimal(6, 1)
  ammoniaMgL         Decimal?   @db.Decimal(6, 3)
  nitriteMgL         Decimal?   @db.Decimal(6, 3)
  alkalinityMgL      Decimal?   @db.Decimal(7, 2)
  waterLevelCm       Decimal?   @db.Decimal(7, 1)
  notes              String?
  responsibleName    String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([pondId])
  @@index([batchId])
  @@index([pondId, date])
  @@index([date])
  @@index([createdAt])
  @@map("water_quality_records")
}

/// Tarea manual (§18-§27 del encargo de Fase 4): a diferencia del resto
/// del dominio productivo, SÍ es mutable — se edita y se completa desde
/// cualquier dispositivo (§19), con el mismo versionado/conflicto
/// last-write-wins que Species/Pond/Feed (§6.4 de IMPLEMENTATION_PLAN.md).
/// `pondId`/`batchId` son opcionales: una tarea puede no estar ligada a
/// ningún estanque ni lote (§23, ej. "Comprar alimento crecimiento").
model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime
  dueTime        String?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(PENDING)
  pondId         String?
  pond           Pond?        @relation(fields: [pondId], references: [id])
  batchId        String?
  batch          FishBatch?   @relation(fields: [batchId], references: [id])
  assignedToName String?
  notes          String?
  completedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  @@index([dueDate])
  @@index([status])
  @@index([pondId])
  @@index([batchId])
  @@index([updatedAt])
  @@map("tasks")
}

// --- Fase 5: economía y cierre productivo ---

/// Configuración de moneda de la finca (§2 del encargo de Fase 5):
/// singleton (siempre `id = "default"`) para no hardcodear "Bs" en cada
/// función — ver src/lib/domain/money.ts. Mutable con el mismo criterio
/// last-write-wins que Species/Pond/Feed (LWW por `version`).
model FarmSettings {
  id             String @id @default("default")
  currencyCode   String @default("BOB")
  currencySymbol String @default("Bs")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  @@map("farm_settings")
}

/// Proveedor (§4-§5 del encargo de Fase 5). Mutable, mismo criterio que
/// Species/Pond/Feed — sin CRM avanzado, solo datos de contacto básicos.
model Supplier {
  id          String  @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  whatsapp    String?
  locality    String?
  address     String?
  notes       String?
  active      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  purchases Purchase[]
  expenses  Expense[]

  @@index([active])
  @@index([updatedAt])
  @@map("suppliers")
}

/// Cliente/comprador (§6-§7). Mismo criterio que Supplier.
model Customer {
  id       String       @id @default(uuid())
  name     String
  type     CustomerType @default(INDIVIDUAL)
  phone    String?
  whatsapp String?
  locality String?
  address  String?
  notes    String?
  active   Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  sales Sale[]

  @@index([active])
  @@index([updatedAt])
  @@map("customers")
}

/// Compra: cabecera (§8-§13). Se crea SIEMPRE junto a sus líneas — y, si
/// alguna línea es de alimento, su FeedInventoryMovement PURCHASE — como
/// una única operación de negocio atómica ("RegisterPurchase", ver
/// applyOperation.ts): nunca una Purchase sin sus líneas ni inventario sin
/// su Purchase (§11). Mutable SOLO para el estado de pago (§32, §57): la
/// UI nunca reedita fecha/proveedor/líneas de una compra ya confirmada
/// (preferir inmutabilidad tras confirmación simplifica la auditoría).
model Purchase {
  id              String        @id @default(uuid())
  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  date            DateTime
  referenceNumber String?
  totalAmount     Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  lines PurchaseLine[]

  @@index([supplierId])
  @@index([date])
  @@index([updatedAt])
  @@map("purchases")
}

/// Línea de compra (§9): append-only, nunca se edita sola — solo existe
/// dentro de la Purchase que la creó.
model PurchaseLine {
  id          String           @id @default(uuid())
  purchaseId  String
  purchase    Purchase         @relation(fields: [purchaseId], references: [id])
  itemType    PurchaseItemType
  feedId      String?
  feed        Feed?            @relation(fields: [feedId], references: [id])
  description String
  quantity    Decimal          @db.Decimal(12, 3)
  unit        String
  unitPrice   Decimal          @db.Decimal(12, 4)
  totalAmount Decimal          @db.Decimal(12, 2)

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([purchaseId])
  @@index([feedId])
  @@index([createdAt])
  @@map("purchase_lines")
}

/// Gasto (§17-§19): append-only — nunca se reedita en el sentido de
/// Species/Pond; una corrección se audita anulando (`deletedAt` +
/// `voidReason`), nunca borrado físico (§58, §72). Nunca duplica una
/// compra ya registrada vía Purchase (§1, §17 — ver ECONOMICS.md).
/// `batchId`/`pondId` opcionales y mutuamente independientes (§18): un
/// gasto puede ser directo a un lote, directo a un estanque, o general
/// (ninguno de los dos) — nunca se distribuye un gasto general sin una
/// política explícita, que esta fase no implementa.
model Expense {
  id          String          @id @default(uuid())
  date        DateTime
  category    ExpenseCategory
  description String
  quantity    Decimal?        @db.Decimal(12, 3)
  unit        String?
  unitPrice   Decimal?        @db.Decimal(12, 4)
  totalAmount Decimal         @db.Decimal(12, 2)
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  batchId     String?
  batch       FishBatch?      @relation(fields: [batchId], references: [id])
  pondId      String?
  pond        Pond?           @relation(fields: [pondId], references: [id])
  notes       String?
  voidReason  String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([date])
  @@index([batchId])
  @@index([pondId])
  @@index([supplierId])
  @@index([createdAt])
  @@map("expenses")
}

/// Cosecha (§20-§26): evento append-only, integrado en el ledger de peces
/// como una salida más (src/lib/domain/batchLedger.ts) — igual criterio
/// que mortalidad/traslado. `averageWeightG` se calcula antes de guardar
/// (`totalWeightKg × 1000 / quantityFish`), igual criterio que Sampling.
model Harvest {
  id              String      @id @default(uuid())
  batchId         String
  batch           FishBatch   @relation(fields: [batchId], references: [id])
  pondId          String
  pond            Pond        @relation(fields: [pondId], references: [id])
  date            DateTime
  quantityFish    Int
  totalWeightKg   Decimal     @db.Decimal(12, 3)
  averageWeightG  Decimal     @db.Decimal(10, 2)
  harvestType     HarvestType @default(PARTIAL)
  responsibleName String?
  notes           String?

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  saleLines SaleLine[]

  @@index([batchId])
  @@index([pondId])
  @@index([batchId, pondId])
  @@index([date])
  @@index([createdAt])
  @@map("harvests")
}

/// Venta: cabecera (§27-§32). Mismo criterio de atomicidad que Purchase —
/// se crea siempre junto a sus líneas como una única operación de negocio
/// ("RegisterSale", ver applyOperation.ts). Mutable SOLO para el estado de
/// pago, igual criterio que Purchase (§57).
model Sale {
  id            String        @id @default(uuid())
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  date          DateTime
  paymentStatus PaymentStatus @default(PENDING)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String
  createdBy String?
  updatedBy String?

  lines SaleLine[]

  @@index([customerId])
  @@index([date])
  @@index([updatedAt])
  @@map("sales")
}

/// Línea de venta (§28-§31): append-only. `harvestId` opcional — si está
/// presente, esta línea descuenta kg disponibles de esa cosecha (§30-§31,
/// validado con lock en applyOperation.ts); si no, es una venta externa/no
/// reconciliada con ninguna cosecha registrada en esta fase.
model SaleLine {
  id           String    @id @default(uuid())
  saleId       String
  sale         Sale      @relation(fields: [saleId], references: [id])
  batchId      String
  batch        FishBatch @relation(fields: [batchId], references: [id])
  harvestId    String?
  harvest      Harvest?  @relation(fields: [harvestId], references: [id])
  description  String
  quantityFish Int?
  weightKg     Decimal   @db.Decimal(12, 3)
  pricePerKg   Decimal   @db.Decimal(12, 4)
  totalAmount  Decimal   @db.Decimal(12, 2)

  deviceId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([saleId])
  @@index([batchId])
  @@index([harvestId])
  @@index([createdAt])
  @@map("sale_lines")
}

// --- Fase 7: hardening final y producción ---

/// Cuenta de usuario (Fase 7, §"Autenticación inicial"/§"Roles básicos").
/// Deliberadamente NO es una entidad offline-first: nunca pasa por
/// Dexie/syncQueue/SyncOperation — se gestiona siempre en línea, contra
/// esta tabla directamente, vía /api/users (solo ADMIN). Es un dato de
/// seguridad, no un dato productivo: tratarlo como el resto del dominio
/// (créalo offline, sincronízalo después) dejaría un dispositivo con un
/// usuario "fantasma" que nadie más reconoce hasta la próxima sync — un
/// riesgo de seguridad, no solo de datos. Ver SECURITY.md.
///
/// `tokenVersion` es el mecanismo de revocación (§"Backups"/seguridad):
/// cada sesión (JWT, ver src/lib/auth/jwt.ts) incluye el `tokenVersion`
/// vigente en el momento del login. Incrementar este campo (cambio de
/// contraseña, "cerrar todas las sesiones" desde /usuarios) invalida
/// TODAS las sesiones emitidas antes de ese momento la próxima vez que
/// cada dispositivo intente sincronizar — nunca antes, porque un
/// dispositivo sin conexión no puede saber que fue revocado (limitación
/// documentada explícitamente en SECURITY.md, es la naturaleza misma de
/// offline-first: revocar solo surte efecto en el próximo contacto con
/// el servidor).
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  tokenVersion Int      @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([active])
  @@map("users")
}

/// Registro de operaciones de sincronización procesadas por el servidor.
/// `operationId` es la clave de idempotencia (§6.5 del plan): reenviar la
/// misma operación de la cola local (mismo id) nunca vuelve a aplicar su
/// efecto sobre las tablas de negocio.
model SyncOperation {
  id           String              @id @default(uuid())
  operationId  String              @unique
  entityType   String
  entityId     String
  operation    SyncOperationType
  deviceId     String
  status       SyncOperationStatus
  errorMessage String?
  processedAt  DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([processedAt])
  @@map("sync_operations")
}
